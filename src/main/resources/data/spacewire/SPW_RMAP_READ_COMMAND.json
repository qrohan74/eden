{
	"name": "SpwRmapReadCommand",
	"type": "container",
	"description": "Remote memory access protocol (ECSS-E-ST-50-52C) - Read Command",
	"fields": [
		{
			"name": "targetSpacewireAddress",
			"description": "Target SpaceWire Address",
			"type": "buffer"
		},
		{
			"name": "targetLogicalAddress",
			"description": "Target Logical Address (8 bits)",
			"type": "parameter",
			"length": 8
		},
		{
			"name": "protocolIdentifier",
			"description": "Protocol Identifier (8 bits)",
			"type": "parameter",
			"length": 8,
			"default": "0x1"
		},
		{
			"name": "instruction",
			"description": "Instruction (8 bits)",
			"type": "container",
			"fields": [
				{
					"name": "packetType",
					"description": "Packet Type (2 bits)",
					"type": "parameter",
					"length": 2,
					"default": 1
				},
				{
					"name": "command",
					"description": "Command type (4 bits)",
					"type": "container",
					"fields": [
						{
							"name": "writeRead",
							"description": "Write (1) / Read (0) (1 bit)",
							"type": "parameter",
							"length": 1,
							"default": 0
						},
						{
							"name": "verify",
							"description": "Verify data, i.e. verify data before write (1) / Don’t Verify (0) (1 bit)",
							"type": "parameter",
							"length": 1,
							"default": 0
						},
						{
							"name": "reply",
							"description": "Reply (1) / No reply (0) (1 bit)",
							"type": "parameter",
							"length": 1,
							"default": 1
						},
						{
							"name": "increment",
							"description": "Increment address (1) / No inc (0) (1 bit)",
							"type": "parameter",
							"length": 1
