					]
				},
				{
					"name": "replyAddressLength",
					"description": "Reply Address Length (0b00 = 0 byte, 0b01 = 4 bytes, 0b10 = 8 bytes, 0b11 = 12 bytes) (2 bits)",
					"type": "parameter",
					"length": 2,
					"default": 1
				}
			]
		},
		{
			"name": "key",
			"description": "Key (8 bits)",
			"type": "parameter",
			"length": 8,
			"default": "0x1"
